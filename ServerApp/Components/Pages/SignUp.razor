@page "/signup"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using ServerApp.Components.Models
@implements IDisposable

<PageTitle>Sign up</PageTitle>

<h1>Sign up</h1>

<p class="text-muted">
    This sample checks username and email availability while you type.
</p>

<EditForm EditContext="editContext" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit" FormName="signup-form">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label" for="username">Username</label>
        <input id="username" class="form-control" value="@model.Username" @oninput="OnUsernameInput" autocomplete="off" />
        <div class="form-text">
            @if (editContext.IsValidationPending(usernameField))
            {
                <span class="text-primary">Checking username availability…</span>
            }
            else if (editContext.IsValidationFaulted(usernameField))
            {
                <span class="text-danger">Username availability could not be checked. Edit the value to retry.</span>
            }
            else
            {
                <span>Try takenuser then newuser for slow-to-fast replacement, or error for faulted.</span>
            }
        </div>
        <ValidationMessage For="() => model.Username" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input id="email" class="form-control" value="@model.Email" @oninput="OnEmailInput" autocomplete="off" />
        <div class="form-text">
            @if (editContext.IsValidationPending(emailField))
            {
                <span class="text-primary">Checking email availability…</span>
            }
            else if (editContext.IsValidationFaulted(emailField))
            {
                <span class="text-danger">Email availability could not be checked. Edit the value to retry.</span>
            }
            else
            {
                <span>Try taken@example.com for taken, error@example.com for faulted, or a new email.</span>
            }
        </div>
        <ValidationMessage For="() => model.Email" />
    </div>

    <button class="btn btn-primary" type="submit">Submit</button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(statusKind == "success" ? "alert-success" : "alert-danger") mt-3">@statusMessage</div>
}


@code {
    private readonly SignUpModel model = new();
    private readonly EditContext editContext;
    private readonly FieldIdentifier usernameField;
    private readonly FieldIdentifier emailField;
    private string? statusMessage;
    private string statusKind = "success";

    public SignUp()
    {
        editContext = new EditContext(model);
        usernameField = new FieldIdentifier(model, nameof(SignUpModel.Username));
        emailField = new FieldIdentifier(model, nameof(SignUpModel.Email));
        editContext.OnValidationStateChanged += HandleValidationStateChanged;
    }

    private void OnUsernameInput(ChangeEventArgs e)
    {
        model.Username = e.Value?.ToString() ?? string.Empty;
        editContext.NotifyFieldChanged(usernameField);
    }

    private void OnEmailInput(ChangeEventArgs e)
    {
        model.Email = e.Value?.ToString() ?? string.Empty;
        editContext.NotifyFieldChanged(emailField);
    }

    private void HandleValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
        => _ = InvokeAsync(StateHasChanged);

    private Task HandleValidSubmit()
    {
        statusKind = "success";
        statusMessage = $"Submit succeeded for {model.Username} and {model.Email}.";
        return Task.CompletedTask;
    }

    private void HandleInvalidSubmit(EditContext _)
    {
        statusKind = "danger";
        statusMessage = "Submit failed. Fix the validation messages above.";
    }

    public void Dispose()
    {
        editContext.OnValidationStateChanged -= HandleValidationStateChanged;
    }
}
